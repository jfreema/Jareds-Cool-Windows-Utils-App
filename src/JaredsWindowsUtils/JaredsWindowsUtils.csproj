<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tray app. Builds on any OS (EnableWindowsTargeting), runs on Windows 10 and 11. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>JaredsWindowsUtils</AssemblyName>
    <RootNamespace>JaredsWindowsUtils</RootNamespace>
    <AssemblyTitle>Jared's Cool Windows Utilities App</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Program.Main starts the app, after checking for another copy -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>JaredsWindowsUtils.Program</StartupObject>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\Tray\*.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JaredsWindowsUtils.Core\JaredsWindowsUtils.Core.csproj" />
  </ItemGroup>
</Project>
